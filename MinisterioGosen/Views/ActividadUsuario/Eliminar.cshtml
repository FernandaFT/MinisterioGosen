@model MinisterioGosen.Models.ActividadUsuarioModel

@{
    ViewData["Title"] = "Eliminar participación";
}

<div class="container py-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-trash-fill me-2 text-danger"></i>
                Eliminar participación
            </h2>
            <p class="text-muted mb-0">
                Confirme si desea eliminar esta participación de forma permanente.
            </p>
        </div>

        <a asp-controller="ActividadUsuario"
           asp-action="Index"
           class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i>
            Volver
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            @if (!string.IsNullOrEmpty(ViewBag.Mensaje))
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    @ViewBag.Mensaje
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="alert alert-danger border-0 rounded-4 d-flex gap-3 align-items-start">
                <i class="bi bi-exclamation-triangle-fill fs-3"></i>

                <div>
                    <h5 class="fw-bold mb-1">Confirmación requerida</h5>
                    <p class="mb-0">
                        Esta acción eliminará la participación de forma permanente.
                        Si tiene información relacionada, el sistema no permitirá eliminarla.
                    </p>
                </div>
            </div>

            <div class="row g-3 my-4">

                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-4">
                        <p class="text-muted small mb-1">Actividad</p>
                        <h6 class="fw-bold mb-0">@Model.NombreActividad</h6>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-4">
                        <p class="text-muted small mb-1">Usuario</p>
                        <h6 class="fw-bold mb-0">@Model.IdentificacionUsuario - @Model.NombreUsuario</h6>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-4">
                        <p class="text-muted small mb-1">Fecha</p>
                        <h6 class="fw-bold mb-0">@Model.Fecha.ToString("dd/MM/yyyy")</h6>
                    </div>
                </div>

                @if (Model.Hora != null)
                {
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-4">
                            <p class="text-muted small mb-1">Hora</p>
                            <h6 class="fw-bold mb-0">@Model.Hora.Value.ToString(@"hh\:mm")</h6>
                        </div>
                    </div>
                }

            </div>

            <form asp-controller="ActividadUsuario"
                  asp-action="ConfirmarEliminar"
                  method="post">

                <input asp-for="Id_Actividad_Usuario" type="hidden" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-controller="ActividadUsuario"
                       asp-action="Index"
                       class="btn btn-outline-secondary rounded-pill px-4">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn btn-danger rounded-pill px-4">
                        <i class="bi bi-trash-fill me-1"></i>
                        Eliminar participación
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>
