@model List<MinisterioGosen.Models.ActividadModel>

@{
    ViewData["Title"] = "Actividades";

    var actividades = Model ?? new List<MinisterioGosen.Models.ActividadModel>();

    var totalActividades = actividades.Count;
    var totalConMinisterio = actividades.Count(x => x.Id_Ministerio != null && x.Id_Ministerio > 0);
}

<div class="container py-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-calendar-event-fill me-2 text-primary"></i>
                Actividades
            </h2>
            <p class="text-muted mb-0">
                Administración de actividades registradas en el sistema.
            </p>
        </div>

        <a asp-controller="Actividad"
           asp-action="Crear"
           class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-plus-circle-fill me-1"></i>
            Nueva actividad
        </a>
    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-primary bg-opacity-10 p-3">
                        <i class="bi bi-calendar-event-fill text-primary fs-4"></i>
                    </div>

                    <div>
                        <p class="text-muted mb-0 small">Total actividades</p>
                        <h4 class="fw-bold mb-0">@totalActividades</h4>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-success bg-opacity-10 p-3">
                        <i class="bi bi-people-fill text-success fs-4"></i>
                    </div>

                    <div>
                        <p class="text-muted mb-0 small">Con ministerio asignado</p>
                        <h4 class="fw-bold mb-0">@totalConMinisterio</h4>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 px-4 pt-4 pb-2">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-list-ul me-2 text-primary"></i>
                Listado de actividades
            </h5>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">

                <table id="tablaActividades"
                       data-datatable
                       class="table table-hover align-middle mb-0 w-100">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Código</th>
                            <th>Actividad</th>
                            <th>Tipo</th>
                            <th>Ministerio responsable</th>
                            <th>Fecha y horario</th>
                            <th>Lugar</th>
                            <th>Estado</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (actividades.Any())
                        {
                            foreach (var item in actividades)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <span class="badge rounded-pill bg-secondary px-3 py-2">
                                            #@item.Id_Actividad
                                        </span>
                                    </td>

                                    <td>
                                        <div class="fw-semibold">
                                            @item.Nombre_Actividad
                                        </div>
                                    </td>

                                    <td>
                                        <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary px-3 py-2">
                                            <i class="bi bi-tag-fill me-1"></i>
                                            @item.Nombre_Tipo
                                        </span>
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrEmpty(item.Descripcion_Ministerio))
                                        {
                                            <div class="fw-semibold">
                                                <i class="bi bi-people-fill me-1 text-success"></i>
                                                @item.Descripcion_Ministerio
                                            </div>

                                            @if (!string.IsNullOrEmpty(item.Observacion_Ministerio_Actividad))
                                            {
                                                <div class="small text-muted">
                                                    @item.Observacion_Ministerio_Actividad
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                <i class="bi bi-dash-circle me-1"></i>
                                                Sin asignar
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="small">
                                            <i class="bi bi-calendar-date me-1 text-primary"></i>
                                            @item.Fecha_Ini.ToString("dd/MM/yyyy")

                                            @if (item.Fecha_Fin != null)
                                            {
                                                <span> - @item.Fecha_Fin.Value.ToString("dd/MM/yyyy")</span>
                                            }
                                        </div>

                                        @if (item.Hora_Ini.HasValue)
                                        {
                                            <div class="small text-muted">
                                                <i class="bi bi-clock me-1"></i>
                                                @item.Hora_Ini.Value.ToString("HH:mm")

                                                @if (item.Hora_Fin.HasValue)
                                                {
                                                    <span> - @item.Hora_Fin.Value.ToString("HH:mm")</span>
                                                }
                                            </div>
                                        }
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrEmpty(item.Lugar))
                                        {
                                            <span>
                                                <i class="bi bi-geo-alt-fill me-1 text-danger"></i>
                                                @item.Lugar
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Sin lugar</span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.Estado == "Inactivo")
                                        {
                                            <span class="badge rounded-pill bg-secondary px-3 py-2">
                                                Inactivo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-success px-3 py-2">
                                                Activo
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end pe-4">
                                        <div class="btn-group" role="group">
                                            <a asp-controller="Actividad"
                                               asp-action="Editar"
                                               asp-route-id="@item.Id_Actividad"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Editar">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>

                                            @if (item.Estado == "Inactivo")
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-success"
                                                        title="Activar"
                                                        onclick="confirmarActivarActividad(this)"
                                                        data-id="@item.Id_Actividad"
                                                        data-nombre="@item.Nombre_Actividad">
                                                    <i class="bi bi-check-circle-fill"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-warning"
                                                        title="Inactivar"
                                                        onclick="confirmarInactivarActividad(this)"
                                                        data-id="@item.Id_Actividad"
                                                        data-nombre="@item.Nombre_Actividad">
                                                    <i class="bi bi-slash-circle"></i>
                                                </button>
                                            }

                                            <a asp-controller="Actividad"
                                               asp-action="Eliminar"
                                               asp-route-id="@item.Id_Actividad"
                                               class="btn btn-sm btn-outline-danger"
                                               title="Eliminar">
                                                <i class="bi bi-trash-fill"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <i class="bi bi-calendar-x text-muted display-4"></i>

                                    <h5 class="fw-bold text-muted mt-3 mb-1">
                                        No hay actividades registradas
                                    </h5>

                                    <p class="text-muted mb-3">
                                        Cuando se creen actividades, aparecerán en este listado.
                                    </p>

                                    <a asp-controller="Actividad"
                                       asp-action="Crear"
                                       class="btn btn-primary rounded-pill px-4">
                                        <i class="bi bi-plus-circle-fill me-1"></i>
                                        Crear actividad
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<!-- Formularios ocultos: se envían tras confirmar con SweetAlert -->
<form id="formInactivarActividad" asp-controller="Actividad" asp-action="Inactivar" method="post" class="d-none">
    <input type="hidden" name="id" id="inactivarId" />
    <input type="hidden" name="origen" value="index" />
</form>

<form id="formActivarActividad" asp-controller="Actividad" asp-action="Activar" method="post" class="d-none">
    <input type="hidden" name="id" id="activarId" />
    <input type="hidden" name="origen" value="index" />
</form>

<script>
    function confirmarInactivarActividad(boton) {
        const nombre = boton.getAttribute("data-nombre");

        Swal.fire({
            title: "Confirmar inactivación",
            text: "¿Desea inactivar la actividad " + nombre + "? Dejará de mostrarse a los usuarios, pero no se eliminará del sistema.",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Inactivar",
            cancelButtonText: "Cancelar",
            confirmButtonColor: "#bf8350",
            cancelButtonColor: "#6c757d"
        }).then(function (resultado) {
            if (resultado.isConfirmed) {
                document.getElementById("inactivarId").value = boton.getAttribute("data-id");
                document.getElementById("formInactivarActividad").submit();
            }
        });
    }

    function confirmarActivarActividad(boton) {
        const nombre = boton.getAttribute("data-nombre");

        Swal.fire({
            title: "Confirmar activación",
            text: "¿Desea activar nuevamente la actividad " + nombre + "?",
            icon: "question",
            showCancelButton: true,
            confirmButtonText: "Activar",
            cancelButtonText: "Cancelar",
            confirmButtonColor: "#064442",
            cancelButtonColor: "#6c757d"
        }).then(function (resultado) {
            if (resultado.isConfirmed) {
                document.getElementById("activarId").value = boton.getAttribute("data-id");
                document.getElementById("formActivarActividad").submit();
            }
        });
    }
</script>